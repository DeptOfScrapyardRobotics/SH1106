{
    "name": "dept-of-scrapyard-robotics/sh1106",
    "description": "Drive SH1106 monochrome OLED displays over I2C or SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "sh1106",
        "oled",
        "display",
        "i2c",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "gpio/nuts-and-bolts": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/i2c": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - DC and RST pins for SH1106SPITransport",
        "gpio/i2c": "^0.10.0 - I2C connections for SH1106I2CTransport",
        "gpio/spi": "^0.10.0 - SPI connections for SH1106SPITransport",
        "microscrap/scrapyard-linux": "^0.10.0 - native i2c-dev, spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE I2C, SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\SH1106\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\SH1106\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\SH1106\\Providers\\SH1106ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
